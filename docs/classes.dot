digraph ManejoCaatingueiro {
    graph [rankdir=LR, splines=ortho, nodesep=0.55, ranksep=0.9, bgcolor="white"];
    node [shape=record, style="filled", fillcolor="#f4f6fa", color="#263b5e", fontname="Arial", fontsize=10];
    edge [color="#52627a", fontname="Arial", fontsize=9, arrowsize=0.7];

    PersistenceEntity [label="{«abstract» PersistenceEntity|id: Long\lcriadoEm: LocalDateTime\latualizadoEm: LocalDateTime\l}", fillcolor="#e5eaf2"];
    Usuario [label="{Usuario|nome: String\ltelefone: String\lsenhaHash: String\lperfil: Perfil\lconsentimentoLocalizacao: boolean\l}"];
    Localidade [label="{Localidade|nome: String\ltipo: TipoLocalidade\llatitude: Double\llongitude: Double\l}"];
    Cultura [label="{Cultura|nome: String\ltipoCriterio: TipoCriterio\llimiarPadraoMm: Double\ljanelaDias: Integer\l}"];
    CulturaLimiarUsuario [label="{CulturaLimiarUsuario|limiarMm: Double\l}"];
    Precipitacao [label="{Precipitacao|volumeMm: Double\ldataEvento: LocalDate\lfonte: FontePrecipitacao\lidClienteSync: String\l}"];
    Reservatorio [label="{Reservatorio|tipo: TipoReservatorio\lapelido: String\l}"];
    RegistroNivel [label="{RegistroNivel|nivelPercentual: Integer\ldataRegistro: LocalDate\lidClienteSync: String\lpendenteSincronizacao: boolean\l}"];
    SerieHistorica [label="{SerieHistorica|mes: Integer\lnormalMm: Double\lanosBase: Integer\lfonte: String\l}"];
    ObservacaoExterna [label="{ObservacaoExterna|dataObservacao: LocalDate\lvalorMm: Double\lfonte: String\l}"];
    SugestaoPlantio [label="{SugestaoPlantio|resultado: NivelSugestao\ldadoUsadoMm: Double\lgrauConfianca: Double\ljustificativa: String\l}"];
    Alerta [label="{Alerta|tipo: TipoAlerta\lseveridade: Severidade\lmensagem: String\lvigenciaInicio: LocalDateTime\l}"];
    Aviso [label="{Aviso|titulo: String\ldescricao: String\l}", fillcolor="#f5e8d5"];
    ChecklistSanitario [label="{ChecklistSanitario|calhasLimpas: boolean\ldescartouPrimeiraChuva: boolean\l}", fillcolor="#f5e8d5"];

    Usuario -> PersistenceEntity [arrowhead=empty];
    Localidade -> PersistenceEntity [arrowhead=empty];
    Cultura -> PersistenceEntity [arrowhead=empty];
    CulturaLimiarUsuario -> PersistenceEntity [arrowhead=empty];
    Precipitacao -> PersistenceEntity [arrowhead=empty];
    Reservatorio -> PersistenceEntity [arrowhead=empty];
    RegistroNivel -> PersistenceEntity [arrowhead=empty];
    SerieHistorica -> PersistenceEntity [arrowhead=empty];
    ObservacaoExterna -> PersistenceEntity [arrowhead=empty];
    SugestaoPlantio -> PersistenceEntity [arrowhead=empty];
    Alerta -> PersistenceEntity [arrowhead=empty];
    Aviso -> PersistenceEntity [arrowhead=empty];
    ChecklistSanitario -> PersistenceEntity [arrowhead=empty];

    Usuario -> Localidade [label="pertence a"];
    Usuario -> Precipitacao [label="registra"];
    Localidade -> Precipitacao;
    Localidade -> Reservatorio;
    Usuario -> Reservatorio [label="responsavel"];
    Reservatorio -> RegistroNivel;
    Localidade -> SerieHistorica;
    Localidade -> ObservacaoExterna;
    Usuario -> CulturaLimiarUsuario;
    Cultura -> CulturaLimiarUsuario;
    Cultura -> SugestaoPlantio;
    Localidade -> SugestaoPlantio;
    Localidade -> Alerta;
    Localidade -> Aviso;
    Localidade -> ChecklistSanitario;
    Reservatorio -> ChecklistSanitario;
}